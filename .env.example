# Public site origin - used for canonical, OG, and JSON-LD absolute URLs
NEXT_PUBLIC_SITE_URL=https://www.thenexcore.com

# NexCore Apps Script web app.
# POST -> form submissions (type: contact | idea | space). The script logs to
#         the Google Sheet and sends its own notification email via MailApp,
#         so no separate mail provider is needed.
# Server-side only: this URL must never reach client code.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxdRxfYdYe9QErC8UfjaI-nnqFYnjuP4YDWkEAN9rwE9SvILVIjrFIVhgNeXG3YT_jY/exec

# Events and members are no longer env-driven: they live in src/data/events.ts
# and src/data/members.ts.

# Room availability lookup (coworking space booking)
AVAILABILITY_URL=https://script.google.com/macros/s/AKfycbxGPBuQ35i7uKWEMOrl_OOTvOXID7hIkxdPPvZFo5mF9X4oD2QCg91sharlzA7r8KLT/exec

# Analytics placeholder. Note: enabling GA4 makes the privacy page's
# "no advertising cookies" statement inaccurate.
NEXT_PUBLIC_GA4_ID=
