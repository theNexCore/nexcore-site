# dependencies
node_modules

# next.js
.next
out
next-env.d.ts
*.tsbuildinfo

# env — never commit real credentials.
# Broad match added by `vercel link`; .env.example is the committed template
# and is explicitly re-included so it is never silently dropped.
.env*
!.env.example

# vercel
.vercel

# os
.DS_Store
Thumbs.db

# audit working files — large crawl artifacts, regenerable.
# The audit reports and structured data ARE committed.
audit/raw
audit/assets
audit/extracted
audit/*.local.json

# Generated by the member image ingest on every build — reflects local state
# (which Drive files were reachable from this machine), so it would churn on
# every commit. Regenerate with `npm run ingest:members`.
audit/member-image-failures.md
